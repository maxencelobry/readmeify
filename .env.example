# ---------------------------------------------------------------------------
# Readmeify — environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Public base URL of this deployment, no trailing slash.
# Must match exactly the OAuth callback URLs registered on GitHub and Spotify.
#
# It MAY include a path prefix — BASE_URL=https://example.com/readmeify — and the
# app then mounts itself under that prefix automatically: every route, asset,
# cookie path, redirect and card URL moves with it. Nothing else to configure.
# The reverse proxy must NOT strip the prefix: in nginx that means
# `proxy_pass http://127.0.0.1:3002;` with NO trailing slash on the target.
BASE_URL=http://127.0.0.1:3000

# Port the HTTP server listens on.
PORT=3000

# Set to "production" behind HTTPS so cookies are issued with the Secure flag.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Secrets — generate fresh random values, never reuse the examples.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------

# Signs session and OAuth state cookies.
SESSION_SECRET=replace-me-with-32-random-bytes-base64

# AES-256-GCM key used to encrypt Spotify refresh tokens at rest.
# Must be exactly 32 bytes, base64 encoded. Rotating it invalidates every
# stored Spotify connection (users simply reconnect).
ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64

# ---------------------------------------------------------------------------
# GitHub OAuth app — https://github.com/settings/developers
# Authorization callback URL: ${BASE_URL}/auth/github/callback
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Shared Spotify app — https://developer.spotify.com/dashboard
# Redirect URI: ${BASE_URL}/auth/spotify/callback
# This is the app every user connects through, so nobody has to hand over
# their own client secret. Required unless you only run in BYO mode.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Let users register their own Spotify app instead of using the shared one.
# Useful while the shared app is still capped at 25 users in Development Mode.
ALLOW_BYO_SPOTIFY_APP=true

# SQLite database file.
DB_PATH=./data/readmeify.db

# Set to 1 when running behind a reverse proxy / PaaS (Fly, Render, Railway…)
# so Express reads X-Forwarded-Proto and X-Forwarded-For correctly.
# A hop count trusts X-Forwarded-For from anyone who can reach the origin
# directly, which lets the rate limiter be bypassed. If your platform gives you
# the proxy's address range, pin it instead: TRUST_PROXY=10.0.0.0/8 (or
# "loopback", or a comma-separated list) is passed to Express verbatim.
TRUST_PROXY=0
